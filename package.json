{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:frontend": "vite",
    "dev:backend": "tsx backend/src/index.ts",
    "build": "npm run build:frontend && npm run build:backend && npm run build:bootstrap",
    "build:frontend": "vite build",
    "build:backend": "esbuild backend/src/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/backend.cjs",
    "build:bootstrap": "esbuild backend/src/db/bootstrap.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/bootstrap.cjs",
    "start": "node dist/backend.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "tsx --test",
    "db:migrate": "tsx backend/src/db/migrate-cli.ts",
    "db:bootstrap": "tsx backend/src/db/bootstrap.ts",
    "db:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File backend/scripts/backup.ps1",
    "db:restore": "powershell -NoProfile -ExecutionPolicy Bypass -File backend/scripts/restore.ps1"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "argon2": "^0.41.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "zod": "^3.25.76"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.15.5"
  }
}
