FROM node:22-bookworm-slim AS build

WORKDIR /app
COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build:backend && npm run build:bootstrap

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production
WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --from=build /app/dist/backend.cjs ./dist/backend.cjs
COPY --from=build /app/dist/backend.cjs.map ./dist/backend.cjs.map
COPY --from=build /app/dist/bootstrap.cjs ./dist/bootstrap.cjs
COPY --from=build /app/dist/bootstrap.cjs.map ./dist/bootstrap.cjs.map
COPY --from=build /app/backend/src/db/migrations ./backend/src/db/migrations
COPY --from=build /app/backend/scripts ./backend/scripts

USER node
EXPOSE 3001
CMD ["node", "dist/backend.cjs"]
